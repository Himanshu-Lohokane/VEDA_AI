# =============================================================================
# VEDA AI - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and should NEVER be committed.
#
# On Vercel: add these same variables in Dashboard > Settings > Environment Variables
# =============================================================================

# --- Backend: Server ---
PORT=3001
NODE_ENV=development

# --- Backend: MongoDB ---
# Local dev:
MONGODB_URI=mongodb://localhost:27017/vedaai-assessment
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vedaai-assessment?retryWrites=true&w=majority

# --- Backend: OpenRouter AI ---
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- Backend: CORS ---
# Local dev: allow the Next.js dev server
# Production: your Vercel URL e.g. https://your-project.vercel.app
CORS_ORIGIN=http://localhost:3000

# --- Frontend: API URL ---
# Local dev: point to local backend server
# Production on Vercel: leave UNSET or empty (relative /api path is used automatically)
NEXT_PUBLIC_API_URL=http://localhost:3001
